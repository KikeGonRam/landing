# URL pública del sitio (sin barra final). Usada en meta Open Graph / Twitter y canonical.
# Ejemplo producción: https://www.tudominio.com
VITE_SITE_URL=https://www.urbakblade.com

# Opcional: endpoint POST JSON para el formulario de contacto.
# Cuerpo: { name, email, service, message }
# Si se omite, el formulario usa mailto: con contactConfig.contactEmail
# VITE_CONTACT_FORM_URL=https://api.tudominio.com/contact
